# These values are public client configuration, visible in the app bundle.
# Use your own development services. Never put provider/admin secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
EXPO_PUBLIC_REVENUECAT_API_KEY=your-revenuecat-public-ios-sdk-key
# AI calls use the authenticated Supabase function named stylo-ai.
# Its provider credentials must remain on the server.
